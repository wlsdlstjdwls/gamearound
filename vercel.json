{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/cron/crawl/**": {
      "regions": [
        "icn1"
      ]
    },
    "src/app/api/debug/reachability/**": {
      "regions": [
        "icn1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo/prices",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo/discover",
      "schedule": "45 1,7,13,19 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo_jp/prices",
      "schedule": "35 */6 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo_jp/discover",
      "schedule": "5 2,8,14,20 * * *"
    },
    {
      "path": "/api/cron/crawl/epic/prices",
      "schedule": "25 */6 * * *"
    },
    {
      "path": "/api/cron/crawl/epic/discover",
      "schedule": "55 3,9,15,21 * * *"
    },
    {
      "path": "/api/cron/crawl/gog/discover",
      "schedule": "10 3,15 * * *"
    },
    {
      "path": "/api/cron/crawl/steam/discover",
      "schedule": "10 4,16 * * *"
    },
    {
      "path": "/api/cron/crawl/psstore/discover",
      "schedule": "30 4,16 * * *"
    },
    {
      "path": "/api/cron/crawl/xbox/discover",
      "schedule": "50 4,16 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
