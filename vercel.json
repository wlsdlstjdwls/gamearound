{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/cron/crawl/**": {
      "regions": [
        "icn1"
      ]
    },
    "src/app/api/debug/reachability/**": {
      "regions": [
        "icn1"
      ]
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo/prices",
      "schedule": "15 */6 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo/discover",
      "schedule": "45 1,7,13,19 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo_jp/prices",
      "schedule": "35 */12 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo_jp/discover",
      "schedule": "5 2,14 * * *"
    },
    {
      "path": "/api/cron/crawl/epic/prices",
      "schedule": "25 */6 * * *"
    },
    {
      "path": "/api/cron/crawl/epic/discover",
      "schedule": "55 3,9,15,21 * * *"
    },
    {
      "path": "/api/cron/crawl/steam/discover",
      "schedule": "10 4,16 * * *"
    },
    {
      "path": "/api/cron/crawl/xbox/discover",
      "schedule": "50 4,16 * * *"
    },
    {
      "path": "/api/cron/crawl/psstore/prices",
      "schedule": "45 */6 * * *"
    },
    {
      "path": "/api/cron/crawl/psstore/discover",
      "schedule": "30 4,16 * * *"
    },
    {
      "path": "/api/cron/crawl/steam/match",
      "schedule": "20 8,20 * * *"
    },
    {
      "path": "/api/cron/crawl/xbox/match",
      "schedule": "40 8,20 * * *"
    },
    {
      "path": "/api/cron/crawl/psstore/match",
      "schedule": "0 9,21 * * *"
    },
    {
      "path": "/api/cron/crawl/epic/match",
      "schedule": "20 9,21 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo/match",
      "schedule": "40 9,21 * * *"
    },
    {
      "path": "/api/cron/crawl/nintendo_jp/match",
      "schedule": "0 10,22 * * *"
    },
    {
      "path": "/api/cron/crawl/wikidata_game/match",
      "schedule": "0 5,11,17,23 * * *"
    },
    {
      "path": "/api/cron/crawl/wikidata_game/collect",
      "schedule": "30 5,11,17,23 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}
