# ===== gamearound 환경변수 예시 =====
# 실제 값은 .env.local(로컬) 또는 Vercel/GitHub Secrets에 넣는다. 이 파일엔 키 이름만.

# Neon Postgres (pooled connection string 권장)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# 인증 (자체 이메일/비밀번호, 세션 쿠키). 별도 키 불필요.
# 관리자 부트스트랩: 쉼표로 구분한 이메일. 가입/로그인 시 role=admin 으로 승격
ADMIN_EMAILS=

# Upstash Redis (REST) — 로그인/가입 레이트리밋, 크롤러 락, 알림 중복키. 없으면 레이트리밋은 경고 후 통과
UPSTASH_REDIS_REST_URL=...   # 또는 Vercel Marketplace 주입값 KV_REST_API_URL
UPSTASH_REDIS_REST_TOKEN=... # 또는 KV_REST_API_TOKEN

# Web Push (VAPID) - "pnpm dlx web-push generate-vapid-keys" 로 생성
NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxx
VAPID_PRIVATE_KEY=xxx
VAPID_SUBJECT=mailto:admin@example.com

# 크롤러(GitHub Actions) -> /api/revalidate 호출 시 x-crawl-secret 헤더
CRAWL_SECRET=change-me
# Vercel Cron -> /api/cron/daily 호출 시 Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me

# 관리자 대시보드 '재실행' 링크용 (owner/repo). 없으면 안내 문구만 표시
NEXT_PUBLIC_GITHUB_REPO=

# 앱 공개 URL (크롤러의 revalidate 호출, OG 이미지 절대 경로에 쓰인다)
# 로컬 개발 서버는 4000번 포트를 쓴다(AGENTS.md)
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Vercel Blob (관리자 업로드 커버 이미지 전용, MVP 선택)
BLOB_READ_WRITE_TOKEN=

# Epic 수집 스위치 — 비워 두면 소스가 비활성이다.
# 지금은 켜도 수집이 안 된다: Cloudflare 가 데이터센터 IP 와 Node 의 TLS 지문을 둘 다 막는다.
# 통과하는 전송 수단(프록시 등)이 생겼을 때만 1 로 켠다.
EPIC_CRAWL_ENABLED=
